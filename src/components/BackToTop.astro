---
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const label = lang === 'es' ? 'Volver arriba' : 'Back to top';
---

<button id="back-to-top" type="button" aria-label={label} title={label} disabled>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true">
    <path d="m5 12 7-7 7 7" /><path d="M12 19V5" />
  </svg>
</button>

<style>
  button {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: calc(32px + env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-grey2);
    border-radius: 50%;
    background: white;
    color: var(--color-primary);
    box-shadow: 0 4px 16px rgb(21 45 67 / 12%);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms, background-color 200ms ease, color 200ms ease;
  }
  button.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
  button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  @media (max-width: 639px) {
    button { width: 56px; height: 56px; }
    button::before { content: ""; position: absolute; inset: -12px; border-radius: 50%; }
    svg { width: 28px; height: 28px; }
  }
  @media (hover: hover) { button:hover { transform: translateY(-3px); background-color: #1f2937; color: white; } }
  @media (min-width: 1024px) { button { right: 32px; bottom: calc(44px + env(safe-area-inset-bottom)); } }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>

<script>
  let cleanup = () => {};
  document.addEventListener('astro:page-load', () => {
    cleanup();
    const button = document.getElementById('back-to-top') as HTMLButtonElement | null;
    if (!button) return;
    const controller = new AbortController();
    const updateVisibility = () => {
      const visible = window.scrollY > 400;
      button.classList.toggle('is-visible', visible);
      button.disabled = !visible;
    };
    window.addEventListener('scroll', updateVisibility, { passive: true, signal: controller.signal });
    button.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('portfolio:back-to-top'));
    }, { signal: controller.signal });
    updateVisibility();
    cleanup = () => controller.abort();
  });
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
