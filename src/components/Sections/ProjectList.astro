---
import {getProjects, getProjectCategories} from '../../lib/projects';
import {getVideoPoster} from '../../lib/video-poster';
import LogoCard from './LogoCard.astro';

interface Props {
  lang: 'es' | 'en';
}

const {lang} = Astro.props;
const [projects, categories] = await Promise.all([
  getProjects(lang, {featuredOnly: false}),
  getProjectCategories(lang),
]);
const labels = lang === 'es' ? {
  title: 'Mis proyectos.',
  title2: 'Diseño, código y creatividad.',
  intro: 'Colección de algunos de mis proyectos personales y open source',
  filter: 'Filtrar proyectos',
  tags: 'Etiquetas',
  all: 'Todos',
  featured: 'Destacados',
  view: 'Ver proyecto',
  empty: 'No hay proyectos con los filtros seleccionados.',
  noProjects: 'Próximamente, nuevos proyectos.',
  singular: 'proyecto',
  plural: 'proyectos',
} : {
  title: 'My projects.',
  title2: 'Design, code and creativity.',
  intro: 'A collection of some of my personal and open source projects',
  filter: 'Filter projects',
  tags: 'Tags',
  all: 'All',
  featured: 'Featured',
  view: 'View project',
  empty: 'No projects match the selected filters.',
  noProjects: 'New projects coming soon.',
  singular: 'project',
  plural: 'projects',
};
---

<main class="bg-white text-gray-900 px-6 lg:px-10 pt-48 md:pt-[350px] pb-24" data-project-list>
  <header class="max-w-3xl mb-12 md:mb-16">
    <h1 class="text-h1 font-light leading-[120%]">
      <span class="text-primary/90">{labels.title}</span>{' '}{labels.title2}
    </h1>
    <p class="text-lg font-light text-gray-600 mt-6">{labels.intro}</p>
  </header>

  <div role="group" aria-label={labels.filter} class="flex flex-wrap gap-3 mb-8" data-project-filters>
    <button type="button" class="project-filter" data-project-filter="" aria-pressed="true">{labels.all}</button>
    <button type="button" class="project-filter" data-project-featured aria-pressed="false">{labels.featured}</button>
    {categories.map((category) => (
      <button type="button" class="project-filter" data-project-filter={category.id} aria-pressed="false">
        {category.title}
      </button>
    ))}
  </div>

  <!-- <p class="text-sm font-light text-gray-500 mb-6" role="status" aria-live="polite" aria-atomic="true"
    data-project-count data-singular={labels.singular} data-plural={labels.plural}>
    {projects.length} {projects.length === 1 ? labels.singular : labels.plural}
  </p> -->

  <div data-project-results>
    {projects.map((project, index) => (
      <article class="project-row border-t border-gray-200"
        data-project-row data-featured={String(project.featured)} data-categories={JSON.stringify(project.categories.map((category) => category.id))}
        aria-labelledby={`project-title-${index}`}>
        <div class="project-content min-w-0">
          <h2 id={`project-title-${index}`} class="text-2xl font-light text-primary leading-tight break-words">{project.title}</h2>
          {project.categories.length > 0 && (
            <ul class="flex flex-wrap gap-2 mt-3" aria-label={labels.tags}>
              {project.categories.map((category) => (
                <li class="rounded-full bg-primary/5 px-3 py-1 text-xs font-medium text-primary">{category.title}</li>
              ))}
            </ul>
          )}
          <p class="text-lg font-light text-gray-600 leading-relaxed whitespace-pre-line mt-3">{project.description}</p>
          {project.url && (
            <a class="project-button mt-4" href={project.url} target="_blank" rel="noopener noreferrer">
              {labels.view}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          )}
        </div>
        <div class="project-media-space">
          {project.mediaType === 'logo' ? (
            <div class="project-media-frame project-media-frame--logo">
              <div class="project-media project-logo"><LogoCard animate={false} compact /></div>
              {project.url && (
                <a class="project-media-overlay" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${labels.view}: ${project.title}`}>
                  <span class="project-media-cta" aria-hidden="true">
                    <span>{labels.view}</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </span>
                </a>
              )}
            </div>
          ) : project.mediaType === 'video' && project.video ? (
            <div class="project-media-frame project-media-frame--video">
              <video class="project-media rounded-lg" data-src={project.video}
                poster={getVideoPoster(project.image?.src)} aria-label={project.title}
                width="1280" height="720" muted loop playsinline preload="none" />
              {project.url && (
                <a class="project-media-overlay project-media-overlay--video" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${labels.view}: ${project.title}`}>
                  <span class="project-media-cta" aria-hidden="true">
                    <span>{labels.view}</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </span>
                </a>
              )}
            </div>
          ) : project.image ? (
            <div class="project-media-frame project-media-frame--image">
              <img class="project-media rounded-lg" src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" />
              {project.url && (
                <a class="project-media-overlay" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${labels.view}: ${project.title}`}>
                  <span class="project-media-cta" aria-hidden="true">
                    <span>{labels.view}</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </span>
                </a>
              )}
            </div>
          ) : null}
        </div>
      </article>
    ))}
  </div>

  <p class="text-lg font-light text-gray-600 border-t border-gray-200 py-16" data-project-empty hidden={projects.length > 0}>
    {projects.length > 0 ? labels.empty : labels.noProjects}
  </p>
</main>

<style>
  .project-filter {
    border: 1px solid var(--color-grey2);
    border-radius: 999px;
    padding: 0.65rem 1.25rem;
    font-size: 0.875rem;
    cursor: pointer;
    color: var(--color-primary);
    transition: background-color 200ms, border-color 200ms, color 200ms;
  }
  .project-filter:hover { border-color: var(--color-primary); }
  .project-filter[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: white; }
  .project-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    transition: background-color 200ms, color 200ms;
  }
  .project-button:hover { background: var(--color-primary); color: white; }
  .project-filter:focus-visible, .project-button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .project-row {
    display: grid;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    transition: padding-block 350ms ease;
  }
  .project-content { max-width: 54ch; }
  .project-media-space {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: auto;
    transition: height 350ms ease;
  }
  .project-media-frame {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    transition: max-height 350ms ease, transform 350ms ease;
  }
  .project-media {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: none;
    object-fit: contain;
    transition: max-height 350ms ease, transform 350ms ease, border-radius 350ms ease;
  }
  .project-media-frame--video video.project-media {
    width: 100%;
    height: auto;
    aspect-ratio: var(--media-ratio, 16 / 9);
  }
  .project-media-overlay {
    top: var(--overlay-top, 0px);
    left: var(--overlay-left, 0px);
    width: var(--overlay-width, 100%);
    height: var(--overlay-height, 100%);
    right: auto;
    bottom: auto;
  }
  .project-logo { aspect-ratio: 16 / 9; }
  video.project-media {
    aspect-ratio: var(--media-ratio, 16 / 9);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    transform: translateZ(0);
  }
  @media (min-width: 768px) {
    .project-row { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem; }
    .project-media-space { height: 11rem; container-type: size; }
    .project-media-frame { width: auto; max-height: 11rem; }
    .project-media-frame--logo { height: 100%; }
    .project-media-frame--video {
      width: min(100cqw, calc(100cqh * var(--media-ratio, 16 / 9)));
      max-height: none;
    }
    .project-media { width: auto; max-height: 11rem; }
    .project-media-frame--video video.project-media {
      width: 100%;
      max-height: none;
    }
    .project-logo { height: 100%; }
    .project-row:focus-within { padding-block: 2rem; }
    .project-row:focus-within .project-media-space { height: 16rem; }
    .project-row:focus-within .project-media-frame:not(.project-media-frame--video),
    .project-row:focus-within .project-media:not(video) { max-height: 16rem; }
    .project-row:focus-within img.project-media,
    .project-row:focus-within video.project-media,
    .project-row:focus-within .project-media-overlay { border-radius: 0; }
  }
  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .project-row.is-hovered { padding-block: 2rem; }
    .project-row.is-hovered .project-media-space { height: 16rem; }
    .project-row.is-hovered .project-media-frame:not(.project-media-frame--video),
    .project-row.is-hovered .project-media:not(video) { max-height: 16rem; }
    .project-row.is-hovered .project-media-frame--image,
    .project-row.is-hovered .project-media-frame--logo {
      transform: rotate(2deg);
    }
    .project-row.is-hovered img.project-media,
    .project-row.is-hovered video.project-media,
    .project-row.is-hovered .project-media-overlay { border-radius: 0; }
  }
  .project-row[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .project-media-overlay--video {
      height: max(0px, calc(var(--overlay-height, 100%) - 2.75rem));
    }
    .project-filter, .project-button, .project-row, .project-media-space, .project-media-frame, .project-media { transition: none; }
    .project-row.is-hovered .project-media-frame,
    .project-row.is-hovered .project-media { transform: none; }
  }
</style>

<script>
  import {createProjectVideos} from '../../scripts/project-videos';
  import {createProjectRowAnimator} from '../../scripts/project-filter-animation';
  import {createProjectHoverTracker} from '../../scripts/project-hover';
  import {createProjectMediaFollow} from '../../scripts/project-media-follow';
  let cleanupProjectFilters = () => {};

  function initializeProjectFilters() {
    cleanupProjectFilters();
    const root = document.querySelector<HTMLElement>('[data-project-list]');
    if (!root) return;
    const controller = new AbortController();
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
    const featuredButton = root.querySelector<HTMLButtonElement>('[data-project-featured]')!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-project-row]')).map((element) => ({
      element,
      featured: element.dataset.featured === 'true',
      categories: JSON.parse(element.dataset.categories || '[]') as string[],
    }));
    const count = root.querySelector<HTMLElement>('[data-project-count]');
    const empty = root.querySelector<HTMLElement>('[data-project-empty]')!;
    let selectedCategory: string | null = null;
    let featuredOnly = false;

    const mobileViewport = window.matchMedia('(max-width: 767px)');
    const createVideos = () => createProjectVideos({maxConcurrent: mobileViewport.matches ? 1 : 3});
    let videos = createVideos();
    mobileViewport.addEventListener('change', () => {
      videos.disconnect();
      videos = createVideos();
      root.querySelectorAll('video').forEach((video) => videos.observe(video));
    }, {signal: controller.signal});
    const frameBindings = new Map<Element, {frame: HTMLElement; media: HTMLElement; overlay: HTMLElement}>();
    const syncFrameOverlay = (frame: HTMLElement, media: HTMLElement, overlay: HTMLElement) => {
      if (!media.offsetWidth || !media.offsetHeight) return;
      overlay.style.setProperty('--overlay-left', `${media.offsetLeft}px`);
      overlay.style.setProperty('--overlay-top', `${media.offsetTop}px`);
      overlay.style.setProperty('--overlay-width', `${media.offsetWidth}px`);
      overlay.style.setProperty('--overlay-height', `${media.offsetHeight}px`);
    };
    const overlayResizeObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const binding = frameBindings.get(entry.target);
        if (binding) syncFrameOverlay(binding.frame, binding.media, binding.overlay);
      }
    });

    rows.forEach(({element}) => {
      const frame = element.querySelector<HTMLElement>('.project-media-frame');
      const media = frame?.querySelector<HTMLElement>('.project-media');
      const overlay = frame?.querySelector<HTMLElement>('.project-media-overlay');
      if (frame && media && overlay) {
        const binding = {frame, media, overlay};
        frameBindings.set(frame, binding);
        frameBindings.set(media, binding);
        overlayResizeObserver.observe(frame);
        overlayResizeObserver.observe(media);
        syncFrameOverlay(frame, media, overlay);
      }

      const video = element.querySelector<HTMLVideoElement>('video');
      if (!video) return;
      videos.observe(video);
      video.addEventListener('loadedmetadata', () => {
        if (frame && video.videoWidth > 0 && video.videoHeight > 0) {
          frame.style.setProperty('--media-ratio', `${video.videoWidth} / ${video.videoHeight}`);
        }
      }, {signal: controller.signal});
      element.addEventListener('focusin', () => videos.prioritize(video), {signal: controller.signal});
    });

    const hoverTracker = createProjectHoverTracker({
      root,
      onHoverChange(row) {
        const video = row?.querySelector<HTMLVideoElement>('video');
        if (video) videos.prioritize(video);
      },
    });
    const mediaFollow = createProjectMediaFollow({root});

    const animator = createProjectRowAnimator({
      durationMs: 900,
      onStart(items) {
        mediaFollow.reset();
        for (const {element, visible} of items) {
          if (!visible) {
            element.querySelectorAll('video').forEach((video) => video.pause());
          }
        }
      },
      onComplete() {
        videos.refresh();
        hoverTracker.sync();
      },
    });

    function updateProjects(animate = true) {
      let visibleCount = 0;
      const items = rows.map(({element, featured, categories}) => {
        const visible = (!featuredOnly || featured) && (!selectedCategory || categories.includes(selectedCategory));
        if (visible) visibleCount++;
        return {element, visible};
      });
      animator.applyVisibility(items, {animate});
      buttons.forEach((button) => {
        const category = button.dataset.projectFilter!;
        button.setAttribute('aria-pressed', String(category ? selectedCategory === category : !selectedCategory && !featuredOnly));
      });
      featuredButton.setAttribute('aria-pressed', String(featuredOnly));
      if (count) count.textContent = `${visibleCount} ${visibleCount === 1 ? count.dataset.singular : count.dataset.plural}`;
      empty.hidden = visibleCount > 0;
    }

    buttons.forEach((button) => button.addEventListener('click', () => {
      const category = button.dataset.projectFilter!;
      if (!category) {
        selectedCategory = null;
        featuredOnly = false;
      } else if (selectedCategory === category) {
        selectedCategory = null;
      } else {
        selectedCategory = category;
        featuredOnly = false;
      }
      updateProjects(true);
    }, {signal: controller.signal}));
    featuredButton.addEventListener('click', () => {
      featuredOnly = !featuredOnly;
      if (featuredOnly) selectedCategory = null;
      updateProjects(true);
    }, {signal: controller.signal});

    updateProjects(false);
    cleanupProjectFilters = () => {
      controller.abort();
      overlayResizeObserver.disconnect();
      frameBindings.clear();
      mediaFollow.disconnect();
      hoverTracker.disconnect();
      animator.disconnect();
      videos.disconnect();
    };
  }

  document.addEventListener('astro:page-load', initializeProjectFilters);
  document.addEventListener('astro:before-swap', () => cleanupProjectFilters());
</script>
