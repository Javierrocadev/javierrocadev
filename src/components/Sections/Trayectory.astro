---
import { sanityClient } from "../../lib/sanity";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const items = await sanityClient.fetch(`
  *[_type == "trajectory"] | order(date desc) {
    title,
    subtitle,
    date,
    description,
    featured
  }
`);

const currentYear = String(new Date().getFullYear());
---

<section class="bg-white text-black pt-20 pb-40 px-6 lg:px-10">
  <div class="mx-auto">
    <div class="max-w-2xl mb-16">
      <h2 class="text-3xl font-light mb-4">
        {lang === "es" ? "Recorrido profesional" : "Professional journey"}
      </h2>
      <p class="text-lg font-light text-gray-600">
        {
          lang === "es"
            ? "Cada etapa ha sumado una capa nueva a cómo entiendo el desarrollo y el diseño."
            : "Each stage has added a new layer to how I understand development and design."
        }
      </p>
    </div>

    <div class="flex flex-col">
      {
        items.map((item, index) => (
          <div
            class={`grid grid-cols-12 gap-6 py-10 border-t border-gray-200 ${
              index === items.length - 1 ? "border-b" : ""
            }`}
          >
            <div class="col-span-12 md:col-span-5">
              <h3 class="text-2xl font-light mb-1 text-black">
                {item.title?.[lang] ?? item.title?.es}
              </h3>
              <span class="text-sm font-light text-gray-400">
                {item.subtitle?.[lang] ?? item.subtitle?.es}
              </span>
            </div>

            <div class="col-span-4 md:col-span-2">
              <span
                class={`text-2xl font-sans ${String(item.date).includes(currentYear) ? "text-primary font-semibold" : "text-gray-300"}`}
              >
                {String(item.date).includes(currentYear)
                  ? lang === "es"
                    ? "Ahora"
                    : "Now"
                  : item.date}
              </span>
            </div>

            <div class="col-span-12 md:col-span-5">
              <p
                class={`text-base font-light leading-relaxed ${
                  item.featured === false ? "text-gray-400" : "text-gray-600"
                }`}
              >
                {item.description?.[lang] ?? item.description?.es}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
