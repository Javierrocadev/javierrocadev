---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(lang);
---

<section class="pt-48 md:pt-[350px] py-20 pb-30  px-6 lg:px-10">
  <div class="max-w-7xl ">

    <div class="md:max-w-[65%] w-full">

      <h1 class="text-[2.5rem] sm:text-h1 font-light leading-[120%]">
        <span class="text-primary/90">
        {t('hero.title')}
        </span> <span class="block lg:max-w-[65%] mt-3 text-[22px] leading-[1.3] sm:mt-4 sm:text-[30px]">{t('hero.title2')}</span>
      </h1>
      <!-- <h2 class="text-h2 font-light mt-6">Ui/Ux - Front-End Developer </h2> -->
    </div>


    <div class="flex flex-row gap-4 mt-12">
<a
  class="
    text-body-sm 
    bg-black 
    text-white 
    flex 
    justify-center 
    items-center 
    w-FIT 
    sm:w-fit 
    rounded-2xl 
    h-12 
    px-6 
    relative 
    overflow-hidden
    cursor-pointer 
    
    group 
    duration-500 
    
    hover:border-blue-500 
    hover:duration-500 
    hover:shadow-sm
    hover:shadow-blue-500/50
    
    after:absolute 
    after:z-10 
    after:w-20 
    after:h-20 
    after:content-[''] 
    after:bg-blue-300 
    after:right-8 
    after:top-3 
    after:rounded-full 
    after:blur-lg 
    after:duration-500
    after:transition-all
    
    before:absolute 
    before:w-12 
    before:h-12 
    before:content-[''] 
    before:right-1 
    before:top-1 
    before:z-10 
    before:bg-blue-500 
    before:rounded-full 
    before:blur-lg 
    before:duration-500 
    before:transition-all

    group-hover:before:duration-500 
    group-hover:after:duration-500 
    
    hover:after:-right-8 
    hover:before:right-12 
    hover:before:-bottom-8 
    hover:before:blur-xl 
    hover:after:blur-xl
  "
  href="#projects"
>
  <span class="relative z-20">
    {t('hero.projects')}
  </span>
</a>
<a
href="https://www.linkedin.com/in/javierrocap/"
target="_blank"
  aria-label="Contactar"
  type="button"
  class="
    text-body-sm 
    bg-white 
    border 
    border-gray-300 
    flex 
    justify-center 
    items-center 
    w-full 
    sm:w-fit 
    rounded-2xl 
    h-12 
    px-6 
    relative 
    overflow-hidden
    cursor-pointer  
    
    group 
    duration-500 
    
    hover:border-blue-500 
    hover:duration-500 
    hover:shadow-sm 
    hover:shadow-blue-500/50
    
    after:absolute 
    after:z-10 
    after:w-20 
    after:h-20 
    after:content-[''] 
    after:bg-blue-300 
    after:right-8 
    after:top-3 
    after:rounded-full 
    after:blur-lg 
    after:duration-500
    after:transition-all
    
    before:absolute 
    before:w-4 
    before:h-4 
    before:content-[''] 
    before:right-1 
    before:top-1 
    before:z-10 
    before:bg-blue-500 
    before:rounded-full 
    before:blur-lg 
    before:duration-500 
    before:transition-all

    group-hover:before:duration-500 
    group-hover:after:duration-500 
    
    hover:after:-right-8 
    hover:before:right-12 
    hover:before:-bottom-8 
    hover:before:blur-xl 
    hover:after:blur-xl
  "
>
  <span class="relative z-20">
    {t('hero.contact')}
  </span>
</a>
   
    </div>
  </div>
</section>


