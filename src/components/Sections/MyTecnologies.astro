---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
import { useTranslations } from "../../i18n/utils";
import shape1 from "../../assets/images/shape1.svg";
import shape2 from "../../assets/images/shape2.svg";
import angular from "../../assets/icons/angular.svg";
import brandAngular from "../../assets/icons/brand-angular.svg";
import brandAstro from "../../assets/icons/brand-astro.svg";
import brandAws from "../../assets/icons/brand-aws.svg";
import brandAzure from "../../assets/icons/brand-azure.svg";
import brandBootstrap from "../../assets/icons/brand-bootstrap.svg";
import brandCSharp from "../../assets/icons/brand-c-sharp.svg";
import brandCpp from "../../assets/icons/brand-cpp.svg";
import brandCypress from "../../assets/icons/brand-cypress.svg";
import brandDocker from "../../assets/icons/brand-docker.svg";
import brandHtml5 from "../../assets/icons/brand-html5.svg";
import brandJavascript from "../../assets/icons/brand-javascript.svg";
import brandLinkedin from "../../assets/icons/brand-linkedin.svg";
import brandNodejs from "../../assets/icons/brand-nodejs.svg";
import brandReactNative from "../../assets/icons/brand-react-native.svg";
import brandReact from "../../assets/icons/brand-react.svg";
import brandTypescript from "../../assets/icons/brand-typescript.svg";
import brandVisualStudio from "../../assets/icons/brand-visual-studio.svg";
import brandVue from "../../assets/icons/brand-vue.svg";
import brandFigma from "../../assets/icons/figma.svg";
import scss from "../../assets/icons/scss.svg";
import sql from "../../assets/icons/sql.svg";
import brandTailwind from "../../assets/icons/tailwind.svg";
import brandCss from "../../assets/icons/css.svg";
import brandVercel from "../../assets/icons/brand-vercel.svg";
import brandThreejs from "../../assets/icons/brand-threejs.svg";
import brandVite from "../../assets/icons/brand-vite.svg";

const t = useTranslations(lang);

const shape1TopIcons = [
  { name: "Figma", src: brandFigma.src },
  { name: "CSS", src: brandCss.src },
  { name: "TypeScript", src: brandTypescript.src },
  { name: "React", src: brandReact.src },
  { name: "JavaScript", src: brandJavascript.src, className: "hide-until-sm" },
  { name: "Tailwind", src: brandTailwind.src, className: "hidden sm:block" },
  { name: "Cypress", src: brandCypress.src },
];

const shape1SideIcons = [
  { name: "Astro", src: brandAstro.src },
  { name: "Azure", src: brandAzure.src },
  { name: "C#", src: brandCSharp.src },
  { name: "SQL", src: sql.src, className: "hide-until-sm" },
  { name: "React Native", src: brandReactNative.src },
];

const shape2Icons = [
  { name: "Docker", src: brandDocker.src },
  { name: "AWS", src: brandAws.src },
  { name: "Vue", src: brandVue.src },
  { name: "Angular", src: brandAngular.src },
  { name: "Vercel", src: brandVercel.src },
  { name: "Vite", src: brandVite.src },
];
---

<section
  class="bg-white text-gray-900 py-20 px-6 lg:px-10 group/tooltip-container"
>
  <div class="mx-auto">
    <div
      class="flex flex-col gap-6 xl:flex-row mb-10 md:mb-16 space-y-4 sm:space-y-0"
    >
      <div class="max-w-xl">
        <h2 class="text-3xl font-light mb-4">
          {t("myTecnologies.title1")}
          <span class="text-primary/70">{t("myTecnologies.title2")}</span>
          {t("myTecnologies.title3")}
          <span class="text-primary/70">{t("myTecnologies.title4")}</span>
          {t("myTecnologies.title5")}
        </h2>
        <p class="text-lg font-light text-gray-600">
          Tailwind - CSS - SCSS - Material UI / MUI - ShadCN
        </p>
        <p class="text-lg font-light text-gray-600">Figma - React - Cypress</p>
        <p class="text-lg font-light text-gray-600">.Net - SQL - Azure - AWS</p>
      </div>
      <div class="w-full flex justify-center xl:mt-40 mt-0 sm:mt-20 relative">
        <div class="flex w-full max-w-md flex-col items-center gap-4">
          <div class="relative w-full max-w-[320px] sm:max-w-none">
            <img
              src={shape1.src}
              alt="Technology shape 1"
              class="h-auto w-full"
            />
            <div class="absolute inset-x-0 top-6 sm:top-10 flex justify-center">
              <div class="flex items-center gap-3 rounded-xl px-4 py-2">
                {
                  shape1TopIcons.map((icon) => (
                    <span
                      class={`tech-icon-wrap inline-flex ${icon.className ?? ""}`}
                    >
                      <img
                        src={icon.src}
                        alt={icon.name}
                        class="tech-icon h-8 sm:h-10 w-auto object-contain"
                      />
                      <span class="tech-tooltip">{icon.name}</span>
                    </span>
                  ))
                }
              </div>
            </div>
            <div class="absolute left-28 sm:left-41 top-[60%] -translate-y-1/2">
              <div
                class="flex flex-col items-center gap-3 rounded-xl px-3 py-4"
              >
                {
                  shape1SideIcons.map((icon) => (
                    <span
                      class={`tech-icon-wrap inline-flex ${icon.className ?? ""}`}
                    >
                      <img
                        src={icon.src}
                        alt={icon.name}
                        class="tech-icon h-8 sm:h-10 w-auto object-contain"
                      />
                      <span class="tech-tooltip">{icon.name}</span>
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="relative w-full max-w-[320px] sm:max-w-none">
            <img
              src={shape2.src}
              alt="Technology shape 2"
              class="h-auto w-full"
            />
            <div class="absolute inset-x-0 top-6 sm:top-10 flex justify-center">
              <div
                class="flex items-center gap-3 justify-center rounded-xl w-full py-2 mx-8"
              >
                {
                  shape2Icons.map((icon) => (
                    <span class="tech-icon-wrap inline-flex">
                      <img
                        src={icon.src}
                        alt={icon.name}
                        class="tech-icon h-8 sm:h-10 w-auto object-contain"
                      />
                      <span class="tech-tooltip">{icon.name}</span>
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div
          class="tip absolute left-1/2 -top-4 -skew-x-[16deg] w-fit h-8 before:absolute before:left-0 before:top-0 before:scale-y-100 sm:before:scale-y-0 before:w-[2px] sm:group-hover/tooltip-container:before:scale-y-100 before:origin-bottom-left sm:group-hover/tooltip-container:before:origin-top-right before:h-full before:duration-150 before:bg-primary before:block after:absolute after:top-0 after:left-0 after:duration-150 sm:group-hover/tooltip-container:after:scale-y-100 after:scale-y-100 sm:after:scale-y-0 after:delay-150 after:bg-primary after:origin-bottom-left after:h-full after:w-[2px]"
        >
          <div
            class="bg-primary block absolute left-0 top-0 w-32 h-[2px] scale-x-100 sm:scale-x-0 sm:group-hover/tooltip-container:scale-x-100 duration-150 origin-top-left"
          >
          </div>
          <p
            class="content font-medium translate-y-0 sm:translate-y-2 sm:group-hover/tooltip-container:translate-y-0 skew-x-[16deg] absolute text-primary -top-full opacity-100 sm:opacity-0 sm:group-hover/tooltip-container:opacity-100 duration-150 whitespace-nowrap ml-2"
          >
            {t("myTecnologies.tag2")}
          </p>
        </div>

        <div
          class="tip absolute left-1/2 sm:left-[52%] bottom-1/3 skew-x-[16deg] w-fit h-8 before:absolute before:left-0 before:bottom-0 before:scale-y-100 sm:before:scale-y-0 before:w-[2px] sm:group-hover/tooltip-container:before:scale-y-100 before:origin-top-left sm:group-hover/tooltip-container:before:origin-bottom-right before:h-full before:duration-150 before:bg-primary before:block after:absolute after:bottom-0 after:left-0 after:duration-150 sm:group-hover/tooltip-container:after:scale-y-100 after:scale-y-100 sm:after:scale-y-0 after:delay-150 after:bg-primary after:origin-top-left after:h-full after:w-[2px]"
        >
          <div
            class="bg-primary block absolute left-0 bottom-0 w-32 h-[2px] scale-x-100 sm:scale-x-0 sm:group-hover/tooltip-container:scale-x-100 duration-150 origin-bottom-left"
          >
          </div>
          <p
            class="content font-medium translate-y-0 sm:translate-y-2 sm:group-hover/tooltip-container:translate-y-0 -skew-x-[16deg] absolute top-1 left-4 text-primary bottom-full opacity-100 sm:opacity-0 sm:group-hover/tooltip-container:opacity-100 duration-150 whitespace-nowrap ml-2"
          >
            {t("myTecnologies.tag1")}
          </p>
        </div>

        <div
          class="tip absolute right-1/2 -bottom-10 -skew-x-[16deg] w-fit h-12 before:absolute before:right-0 before:bottom-0 before:scale-y-100 sm:before:scale-y-0 before:w-[2px] sm:group-hover/tooltip-container:before:scale-y-100 before:origin-top-right sm:group-hover/tooltip-container:before:origin-bottom-left before:h-full before:duration-150 before:bg-primary before:block after:absolute after:bottom-0 after:right-0 after:duration-150 sm:group-hover/tooltip-container:after:scale-y-100 after:scale-y-100 sm:after:scale-y-0 after:delay-150 after:bg-primary after:origin-top-right after:h-full after:w-[2px]"
        >
          <div
            class="bg-primary block absolute right-0 bottom-0 w-32 h-[2px] scale-x-100 sm:scale-x-0 sm:group-hover/tooltip-container:scale-x-100 duration-150 origin-bottom-right"
          >
          </div>
          <p
            class="content font-medium translate-y-0 sm:translate-y-2 sm:group-hover/tooltip-container:translate-y-0 skew-x-[16deg] absolute top-4 right-2 text-primary bottom-full opacity-100 sm:opacity-0 sm:group-hover/tooltip-container:opacity-100 duration-150 whitespace-nowrap mr-2 text-right"
          >
            {t("myTecnologies.tag3")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hide-until-sm {
    display: none !important;
  }

  @media (min-width: 640px) {
    .hide-until-sm {
      display: inline-flex !important;
    }
  }

  .tech-icon-wrap {
    position: relative;
    align-items: center;
    justify-content: center;
    border-radius: 0.6rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .tech-icon {
    position: relative;
    z-index: 1;
    transform-origin: center;
    transition:
      transform 180ms ease,
      filter 180ms ease;
  }

  .tech-icon-wrap:hover .tech-icon {
    transform: scale(1.08);
    filter: brightness(1.03) drop-shadow(1px 0 0 rgba(21, 45, 67, 0.4))
      drop-shadow(0 0 0 rgba(21, 45, 67, 0.4))
      drop-shadow(0 0 0 rgba(21, 45, 67, 0.4))
      drop-shadow(0 0 0 rgba(21, 45, 67, 0.4));
  }

  .tech-tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(4px);
    padding: 0.3rem 0.55rem;
    border-radius: 0.45rem;
    border: 1px solid rgba(17, 24, 39, 0.12);
    background: rgba(255, 255, 255, 0.96);
    color: rgb(17, 24, 39);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 6px 20px -10px rgba(17, 24, 39, 0.35);
    transition:
      opacity 120ms ease,
      transform 120ms ease,
      visibility 120ms ease;
    z-index: 10;
  }

  .tech-tooltip::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 7px;
    height: 7px;
    border-right: 1px solid rgba(17, 24, 39, 0.12);
    border-bottom: 1px solid rgba(17, 24, 39, 0.12);
    background: rgba(255, 255, 255, 0.96);
    transform: translateX(-50%) rotate(45deg);
  }

  .tech-icon-wrap:hover .tech-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
</style>
