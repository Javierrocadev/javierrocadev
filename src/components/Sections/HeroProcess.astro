---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(lang);
---

<section class="pt-48 md:pt-[350px] py-20   px-6 lg:px-10">
  <div class="max-w-7xl ">

    <div class="md:max-w-[65%] w-full">

      <h1 class="text-h1 font-light leading-[120%]">
        <span class="text-primary/90">
        {t('process.title1')}
        </span>{t('process.title2')}
      </h1>
      </div>
  </div>
</section>


