---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang);
---

<section class="pt-48 md:pt-[350px] py-20 px-6 lg:px-10">
  <div
    class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between md:gap-0"
  >
    <div class="w-full md:max-w-[60%] xl:max-w-[50%]">
      <h1 class="text-h1 font-light leading-[120%]">
        <span class="text-primary/90">
          {t("aboutme.title")}
        </span>{t("aboutme.title2")}
      </h1>
      <h2 class="text-h3 font-light mt-6">
        <span class="font-bold">{t("aboutme.role")} </span>{
          t("aboutme.roletext")
        }
      </h2>
      <h2 class="text-h3 font-light mt-3">
        <span class="font-bold">{t("aboutme.hobbies")} </span>{
          t("aboutme.hobbiestext")
        }
      </h2>
    </div>

    <figure class="w-full shrink-0 md:w-[35%] xl:w-[40%]">
      <svg
        class="circles block aspect-square w-full rounded-2xl"
        viewBox="0 0 200 200"
        role="img"
        aria-label="Visual principal del portfolio"
      >
        <defs>
          <clipPath id="profile-circles">
            <circle class="profile-circle" cx="95" cy="75" r="71"></circle>
            <circle class="profile-circle" cx="31" cy="157" r="13"></circle>
            <circle class="profile-circle" cx="130" cy="165" r="15"></circle>
            <circle class="profile-circle" cx="170" cy="135" r="6"></circle>
          </clipPath>
        </defs>
        <image
          href="https://jrdevportfolio.vercel.app/_astro/perfil-bg.JZQ4zR22.webp"
          width="200"
          height="200"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#profile-circles)"
        />
      </svg>
    </figure>
  </div>
</section>

<style>
  .circles {
    cursor: pointer;
  }

  .profile-circle {
    transition: r 700ms ease-in-out;
  }

  .circles:hover .profile-circle {
    r: 200px;
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-circle {
      transition: none;
    }
  }
</style>
