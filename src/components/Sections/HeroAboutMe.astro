---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang);
---

<section class="pt-48 md:pt-[350px] py-20 px-6 lg:px-10">
  <div class="max-w-7xl">
    <div class="md:max-w-[65%] w-full">
      <h1 class="text-h1 font-light leading-[120%]">
        <span class="text-primary/90">
          {t("aboutme.title")}
        </span>{t("aboutme.title2")}
      </h1>
      <h2 class="text-h3 font-light mt-6">
        <span class="font-bold">{t("aboutme.role")} </span>{
          t("aboutme.roletext")
        }
      </h2>
      <h2 class="text-h3 font-light mt-3">
        <span class="font-bold">{t("aboutme.hobbies")} </span>{
          t("aboutme.hobbiestext")
        }
      </h2>
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="max-w-full mx-auto">
    <figure class="mx-auto w-full overflow-hidden">
      <div
        style="aspect-ratio:16/9"
        class="h-auto aspect-video w-full relative"
      >
        <img
          class="h-full w-full object-cover object-center"
          src="https://jrdevportfolio.vercel.app/_astro/perfil-bg.JZQ4zR22.webp"
          width="100%"
          alt="Visual principal del portfolio"
          fetchpriority="high"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent"
        >
        </div>
      </div>
    </figure>
  </div>
</section>
