        <style>
  .loader {
    display: block;
    height: auto;
    overflow: visible;
    position: relative;
    margin-bottom: 6px;
  }
  .path {
    fill: none;
  }
  .loader .dash .path {
    stroke: rgba(255, 255, 255, 0.1);

    stroke-linecap: round;
    pathlength: 360;
  }
  .logopr .path {
    fill: transparent;
    transition: fill 0.6s ease;
  }
  .logocontainer:hover .path:not(.dash-normal):not(.dash-reverse) {
    fill: rgba(252, 228, 228, 0.7);
  }
  .loader:hover line {
    stroke: rgba(10, 24, 33, 0.6);

    stroke-linecap: round;
    pathlength: 360;
  }
  .loader line,
  .loader circle {
    transition: opacity 0.6s ease;
  }

  .logocontainer:hover line,
  .logocontainer:hover circle {
    opacity: 0;
    transition: opacity 2s ease;
    stroke: rgba(214, 225, 233, 0.6);
  }


  .dash-normal {
    animation:
      dashArray 7s ease-in-out infinite,
      dashOffset 7s linear infinite;
  }


  .dash-reverse {

    animation:
      dashArray 7s ease-in-out infinite,
      dashOffsetReverse 7s linear infinite;
  }

  @keyframes dashArray {
    0% {
      stroke-dasharray: 0 1 359 0;
    }
    50% {
      stroke-dasharray: 0 359 1 0;
    }
    100% {
      stroke-dasharray: 359 1 0 0;
    }
  }

  @keyframes dashOffset {
    0% {
      stroke-dashoffset: -5;
    }
    100% {
      stroke-dashoffset: -365;
    }
  }

  @keyframes dashOffsetReverse {
    0% {
      stroke-dashoffset: 365;
    }
    100% {
      stroke-dashoffset: 5;
    }
  }
</style>