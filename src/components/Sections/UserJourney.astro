---
// Importa tus traducciones como en el resto del código
const { lang } = Astro.props;
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(lang);
---

<section class="bg-white text-gray-900 py-20 px-6 lg:px-10 flex flex-col">
  <div class="max-w-xl mb-12">
    <h2 class="text-3xl font-light mb-4">{t('userJourney.title')}</h2>
    <p class="text-lg font-light text-gray-600">
      {t('userJourney.desc')}
    </p>
  </div>

  <div
    class="w-full h-fit flex flex-col gap-8 justify-center items-center bg-gray-100/50 rounded-xl py-12 sm:p-12 border border-gray-200"
  >
    <!-- CAMBIAR ESTO-->
<div class="w-full max-w-5xl relative" id="user-journey">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-6 relative mx-2">
        
        <div class="journey-node group cursor-crosshair" data-step="0">
          <div class="relative h-52 bg-white border border-slate-200 rounded-xl p-6 transition-all duration-300 hover:border-slate-400 hover:shadow-sm">
            <div class="flex justify-between items-center mb-6">
              <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">{t('userJourney.step')} 01</span>
              <div class="h-2 w-2 rounded-full bg-slate-200 group-hover:bg-slate-500 transition-colors duration-300"></div>
            </div>
            <h3 class="text-lg font-semibold text-slate-700 mb-4 transition-colors group-hover:text-slate-900">{t('userJourney.step1')}</h3>
            <div class="space-y-2">
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step1.1')}</p>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step1.2')}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="journey-node group cursor-crosshair" data-step="1">
          <div class="relative h-52 bg-white border border-slate-200 rounded-xl p-6 transition-all duration-300 hover:border-slate-400 hover:shadow-sm">
            <div class="flex justify-between items-center mb-6">
              <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">{t('userJourney.step')} 02</span>
              <div class="h-2 w-2 rounded-full bg-slate-200 group-hover:bg-slate-500 transition-colors duration-300"></div>
            </div>
            <h3 class="text-lg font-semibold text-slate-700 mb-4 transition-colors group-hover:text-slate-900">{t('userJourney.step2')}</h3>
            <div class="space-y-2">
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step2.1')}</p>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step2.2')}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="journey-node group cursor-crosshair" data-step="2">
          <div class="relative h-52 bg-white border border-slate-200 rounded-xl p-6 transition-all duration-300 hover:border-slate-400 hover:shadow-sm">
            <div class="flex justify-between items-center mb-6">
              <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">{t('userJourney.step')} 03</span>
              <div class="h-2 w-2 rounded-full bg-slate-200 group-hover:bg-slate-500 transition-colors duration-300"></div>
            </div>
            <h3 class="text-lg font-semibold text-slate-700 mb-4 transition-colors group-hover:text-slate-900">{t('userJourney.step3')}</h3>
            <div class="space-y-2">
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step3.1')}</p>
              </div>
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-500 font-medium">{t('userJourney.step3.2')}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="journey-node group cursor-crosshair" data-step="3">
          <div class="relative h-52 bg-primary border border-slate-800 rounded-xl p-6 transition-all duration-300 hover:bg-slate-900">
            <div class="flex justify-between items-center mb-6">
              <span class="text-[10px] font-bold tracking-widest text-slate-500 uppercase transition-colors group-hover:text-slate-400">{t('userJourney.step')} 04</span>
              <div class="h-2 w-2 rounded-full bg-slate-600 group-hover:bg-slate-100 transition-colors duration-300"></div>
            </div>
            <h3 class="text-lg font-semibold text-white mb-4">{t('userJourney.step4')}</h3>
            <div class="space-y-2">
              <div class="bg-slate-700/50 border border-slate-600/50 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-300 font-medium">{t('userJourney.step4.1')}</p>
              </div>
              <div class="bg-slate-700/50 border border-slate-600/50 rounded-md px-3 py-1.5">
                <p class="text-[11px] text-slate-300 font-medium">{t('userJourney.step4.2')}</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="max-w-xl mx-auto mt-40 ">
    <p class="text-lg font-light text-gray-600 text-center">
      {t('userJourney.final')}
    </p>
  </div>
</section>