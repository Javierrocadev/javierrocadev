---
// Importa tus traducciones como en el resto del código
const { lang } = Astro.props;
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(lang);
---

<section class="bg-white text-gray-900 py-20 px-6 lg:px-10 flex flex-col">
  <div class="max-w-xl mb-12">
    <h2 class="text-3xl font-light mb-4">Diseñando el recorrido del usuario</h2>
    <p class="text-lg font-light text-gray-600">
      Antes de abrir Figma o escribir una línea de código, necesito entender el viaje que hará cada persona en el sitio. ¿Qué busca? ¿Dónde puede perderse? ¿Qué acción quiero que realice?
    </p>
  </div>

  <div
    class="w-full h-fit flex flex-col gap-8 justify-center items-center bg-gray-100/50 rounded-xl py-12 sm:p-12 border border-gray-200"
  >
    <!-- Contenedor del User Journey Interactivo -->
    <div class="w-full max-w-4xl relative" id="user-journey">
      <!-- Línea de progreso animada -->
      <svg class="w-full h-2 mb-8" viewBox="0 0 800 8" preserveAspectRatio="none">
        <path
          id="journey-path"
          d="M 0 4 L 800 4"
          stroke="#e5e7eb"
          stroke-width="4"
          fill="none"
        />
        <path
          id="journey-progress"
          d="M 0 4 L 800 4"
          stroke="url(#gradient)"
          stroke-width="4"
          fill="none"
          stroke-dasharray="800"
          stroke-dashoffset="800"
          class="transition-all duration-1000 ease-out"
        />
        <defs>
          <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Nodos del Journey -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 relative">
  <!-- Nodo 1: Landing -->
  <div
    class="journey-node relative text-primary h-52 overflow-hidden rounded-2xl group cursor-pointer"
    data-step="0"
    style="background: linear-gradient(135deg, rgb(0, 29, 161) 0%, #152d43 100%);"
  >
    <div
      class="absolute inset-3 z-[1] flex flex-col items-start justify-between rounded-xl bg-[#f6f3f4] p-5 text-white border-2 border-white/20"
    >
      <div class="flex justify-between items-start w-full">
        <div class="text-left">
          <p class="text-2xl font-bold mb-1 text-primary">Landing</p>
        </div>
        <div class="h-2 w-2 rounded-full bg-primary"></div>
      </div>

      <div class="w-full space-y-2 text-primary">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-black/20">
          <p class="text-xs ">Captar atención</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-black/20">
          <p class="text-xs ">3 segundos</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Nodo 2: Explorar -->
  <div
    class="journey-node relative h-52 overflow-hidden rounded-2xl group cursor-pointer"
    data-step="1"
    style="background: linear-gradient(135deg, #667eea 0%, rgb(21 45 67) 100%);"
  >
    <div
      class="absolute inset-3 z-[1] flex flex-col items-start justify-between rounded-xl bg-[#1a1a1a] p-5 text-white border-2 border-white/20"
    >
      <div class="flex justify-between items-start w-full">
        <div class="text-left">
          <p class="text-2xl font-bold mb-1">Explorar</p>
        </div>
        <div class="h-2 w-2 rounded-full bg-white/50"></div>
      </div>

      <div class="w-full space-y-2">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">Navegación clara</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">Contenido organizado</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Nodo 3: Interacción -->
  <div
    class="journey-node relative h-52 overflow-hidden rounded-2xl group cursor-pointer"
    data-step="2"
    style="background: linear-gradient(135deg, #667eea 0%, rgb(21 45 67) 100%);"
  >
    <div
      class="absolute inset-3 z-[1] flex flex-col items-start justify-between rounded-xl bg-[#1a1a1a] p-5 text-white border-2 border-white/20"
    >
      <div class="flex justify-between items-start w-full">
        <div class="text-left">
          <p class="text-2xl font-bold mb-1">Interacción</p>
        </div>
        <div class="h-2 w-2 rounded-full bg-white/50"></div>
      </div>

      <div class="w-full space-y-2">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">Micro-interacciones</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">Feedback visual</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Nodo 4: Conversión -->
  <div
    class="journey-node relative h-52 overflow-hidden rounded-2xl group cursor-pointer"
    data-step="3"
    style="background: linear-gradient(135deg, #667eea 0%, rgb(21 45 67) 100%);"    
  >
    <div
      class="absolute inset-3 z-[1] flex flex-col items-start justify-between rounded-xl bg-[#1a1a1a] p-5 text-white border-2 border-white/20"
    >
      <div class="flex justify-between items-start w-full">
        <div class="text-left">
          <p class="text-2xl font-bold mb-1">Conversión</p>
        </div>
        <div class="h-2 w-2 rounded-full bg-white/50"></div>
      </div>

      <div class="w-full space-y-2">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">CTA clara</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-2 border border-white/20">
          <p class="text-xs text-gray-300">Proceso simple</p>
        </div>
      </div>
    </div>
  </div>
</div>
    </div>
  </div>

  <div class="max-w-xl mx-auto my-20">
    <p class="text-lg font-light text-gray-600 text-center">
      Este mapa me permite diseñar con propósito. Cada botón, cada sección, cada animación tiene una razón de ser dentro del flujo completo.
    </p>
  </div>
</section>

<script>
  // Animación de la línea de progreso cuando los nodos entran en hover
  const nodes = document.querySelectorAll('.journey-node');
  const progressLine = document.getElementById('journey-progress');

  nodes.forEach((node, index) => {
    node.addEventListener('mouseenter', () => {
      const progress = ((index + 1) / nodes.length) * 800;
      if (progressLine) {
        progressLine.style.strokeDashoffset = `${800 - progress}`;
      }
    });
  });

  // Animación automática al cargar la página
  window.addEventListener('load', () => {
    setTimeout(() => {
      if (progressLine) {
        progressLine.style.strokeDashoffset = '0';
      }
    }, 500);
  });
</script>