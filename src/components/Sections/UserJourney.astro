---
// Importa tus traducciones como en el resto del código
const { lang } = Astro.props;
import { useTranslations } from "../../i18n/utils";
const t = useTranslations(lang);
---

<section class="bg-white text-black py-20 px-6 lg:px-4">
  <div class="mx-auto">
    <div class="max-w-2xl mb-12 mx-auto text-center">
      <h2 class="text-3xl font-light mb-4">
        {t("userJourney.title.1")}
        <span class="text-primary/70">{t("userJourney.title.2")}</span>
      </h2>
      <p class="text-lg font-light text-gray-600">
        {t("userJourney.desc")}
      </p>
      <!-- Stepper visual que refleja los 4 pasos -->
      <div
        class="flex items-center justify-center gap-2 my-8"
        aria-hidden="true"
      >
        <div data-dot="1" class="h-2 w-2 rounded-full"></div>
        <div class="h-px w-8 bg-slate-200"></div>
        <div data-dot="2" class="h-2 w-2 rounded-full"></div>
        <div class="h-px w-8 bg-slate-200"></div>
        <div data-dot="3" class="h-2 w-2 rounded-full"></div>
      </div>

      <!-- Línea conectora hacia el contenido -->
      <!-- <div class="mt-8 flex justify-center" aria-hidden="true">
        <div class="h-12 w-px bg-gradient-to-b from-slate-300 to-transparent">
        </div>
      </div> -->
    </div>

    <div
      id="user-journey-grid"
      class="relative grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-200 rounded-xl overflow-hidden"
    >
      <div
        id="hover-highlight"
        class="absolute pointer-events-none transition-all duration-300 ease-out rounded-xl opacity-0 z-0"
        style="background: linear-gradient(to right, rgb(235, 242, 252) 0%, transparent 70%);"
      >
      </div>
      <div
        data-card="1"
        class="bg-white p-10 flex flex-col gap-4 group relative overflow-hidden transition-shadow duration-300 hover:shadow-lg z-10"
      >
        <div
          class="absolute -top-28 -right-28 w-72 h-72 rounded-bl-full bg-[#EDF3FC] blur-3xl translate-x-full -translate-y-full group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-700 ease-out"
        >
        </div>
        <span
          class="relative z-10 text-xs font-medium tracking-widest text-gray-400 group-hover:text-primary uppercase transition-colors duration-300"
          >{t("userJourney.card1.tag")}</span
        >
        <h3 class="relative z-10 text-2xl font-light text-black">
          {t("userJourney.card1.title")}
        </h3>
        <p
          class="relative z-10 text-base font-light text-gray-600 leading-relaxed"
        >
          {t("userJourney.card1.desc")}
        </p>
      </div>

      <div
        data-card="2"
        class="bg-white p-10 flex flex-col gap-4 group relative overflow-hidden transition-shadow duration-300 hover:shadow-lg z-10"
      >
        <div
          class="absolute -top-28 left-0 w-full h-56 rounded-b-full bg-[#EDF3FC] blur-3xl -translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-out"
        >
        </div>
        <span
          class="relative z-10 text-xs font-medium tracking-widest text-gray-400 group-hover:text-primary uppercase transition-colors duration-300"
          >{t("userJourney.card2.tag")}</span
        >
        <h3 class="relative z-10 text-2xl font-light text-black">
          {t("userJourney.card2.title")}
        </h3>
        <p
          class="relative z-10 text-base font-light text-gray-600 leading-relaxed"
        >
          {t("userJourney.card2.desc")}
        </p>
      </div>

      <div
        data-card="3"
        class="bg-white p-10 flex flex-col gap-4 group relative overflow-hidden transition-shadow duration-300 hover:shadow-lg z-10"
      >
        <div
          class="absolute -top-28 -left-28 w-72 h-72 rounded-br-full bg-[#EDF3FC] blur-3xl -translate-x-full -translate-y-full group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-700 ease-out"
        >
        </div>
        <span
          class="relative z-10 text-xs font-medium tracking-widest text-gray-400 group-hover:text-primary uppercase transition-colors duration-300"
          >{t("userJourney.card3.tag")}</span
        >
        <h3 class="relative z-10 text-2xl font-light text-black">
          {t("userJourney.card3.title")}
        </h3>
        <p
          class="relative z-10 text-base font-light text-gray-600 leading-relaxed"
        >
          {t("userJourney.card3.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  [data-dot] {
    background-color: #cbd5e1;
    transition: background-color 0.3s;
  }
  section:has([data-card="1"]:hover) [data-dot="1"],
  section:has([data-card="2"]:hover) [data-dot="2"],
  section:has([data-card="3"]:hover) [data-dot="3"] {
    background-color: rgb(21 45 67);
  }
</style>

<script>
  const grid = document.getElementById("user-journey-grid");
  const highlight = document.getElementById("hover-highlight");

  if (grid && highlight) {
    const cards = grid.querySelectorAll("[data-card]");
    let currentCard = null;

    const moveHighlight = (card) => {
      if (!card) {
        highlight.style.opacity = "0";
        currentCard = null;
        return;
      }

      const rect = card.getBoundingClientRect();
      const gridRect = grid.getBoundingClientRect();

      highlight.style.top = `${rect.top - gridRect.top}px`;
      highlight.style.left = `${rect.left - gridRect.left}px`;
      highlight.style.width = `${rect.width}px`;
      highlight.style.height = `${rect.height}px`;
      highlight.style.opacity = "1";
    };

    grid.addEventListener("mouseleave", () => {
      highlight.style.opacity = "0";
      currentCard = null;
    });

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        if (card !== currentCard) {
          currentCard = card;
          moveHighlight(card);
        }
      });
    });
  }
</script>
