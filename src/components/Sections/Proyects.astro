---
// Importa las imágenes que quieres usar.
// Las he nombrado siguiendo la convención de la imagen original para claridad.
import uiverse from "/public/images/uiversevideocover.jpg";
import imgChapman from "/public/images/uiversevideocover.jpg";
import imgSmuggler from "/public/images/tailsnippet.png";
import a from "/public/images/bentoportfolio.png";
import otherPortfolio from "/public/images/otherportfolio.png";

// La ruta de las imágenes debe ajustarse a la ubicación real en tu proyecto,
// por ejemplo, si están en src/assets/.
const svgLogo = "";
const images = [
  { src: uiverse.src, alt: "Biblioteca de componentes open source" },
  { src: imgChapman.src, alt: "TailSnippets" },
  { src: imgSmuggler.src, alt: "logo" },
  { src: otherPortfolio.src, alt: "Bento portfolio" },
  { src: a.src, alt: "Proximamente..." },
];
---

<section class="mx-auto py-20 sm:px-6 lg:px-8">
  <div class="grid gap-6 md:gap-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <div class="flex flex-col">
      
         <div
          class="logocontainer h-full group overflow-hidden relative rounded-2xl bg-[#214567] p-0.5 shadow-[0px_2px_5px_#e1e1e1]  hover:shadow-md hover:scale-95 hover:rotate-2 transition-all duration-300"
        >
       

              <div class="relative  ">
               <img
          src={uiverse.src}
          alt={images[0].alt}
          class="w-full h-auto object-cover"
        />
             
         
          </div>
        </div>
        <p
          class="mt-2 text-body uppercase tracking-wider font-medium text-gray-700"
        >
          Open Source components
        </p>
      </div>
      <div class="flex flex-col">
        <div
          class="logocontainer h-full group relative rounded-2xl bg-[#214567] p-0.5 shadow-[0px_2px_5px_#e1e1e1] hover:shadow-md hover:scale-95 hover:rotate-2 transition-all duration-300"
        >
          <div
            class="relative h-full w-full aspect-video overflow-hidden rounded-xl p-4 shadow-[0px_0px_4px_#d3d3d3]"
