---
import LogoCard from "./LogoCard.astro";
import { getProjects } from "../../lib/projects";
import { getVideoPoster } from "../../lib/video-poster";
import logoSvg from "/public/favicon.svg?raw";
const logoPath = logoSvg.match(/\bd="([^"]+)"/)?.[1];
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
const initialProject = projects[0];

const projectsData = projects.map((p, i) => ({
  index: i,
  title: p.title,
  hasComponent: p.mediaType === "logo",
  mediaType: p.mediaType,
  image: p.image || null,
  video: p.video,
  poster: getVideoPoster(p.image?.src),
  description: p.description,
  url: p.url || null,
}));
const viewProjectLabel = lang === "es" ? "Ver proyecto" : "View project";
---

{initialProject && <section id="projects" class="bg-white text-gray-900 py-20 px-6 lg:px-10">
  <div class="mx-auto">
    <div
      class="flex flex-col gap-16 lg:flex-row items-start mb-10 md:mb-16 space-y-4 sm:space-y-0"
    >
      <!-- LEFT: Títulos -->
      <div class="max-w-xl" id="project-titles">
        {
          projects.map((project, index) => (
            <h2
              class={`relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)]
              ${index === 0 ? "font-semibold text-primary" : "font-light text-gray-400 hover:text-gray-600"}`}
              data-index={index}
              onclick="selectProject(this)"
            >
              {project.title}
            </h2>
          ))
        }
        <a
          href={lang === "es" ? "/projects" : "/en/projects"}
          class="inline-flex items-center gap-3 mt-6 rounded-full border border-primary px-5 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
        >
          {lang === "es" ? "Ver todos los proyectos" : "View all projects"}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- RIGHT -->
      <div
        class="w-full sm:aspect-video aspect-auto rounded-2xl bg-primary/20 overflow-hidden flex items-center justify-center"
      >
        <div
          class="min-h-96 relative w-full h-full flex flex-col gap-4 justify-center items-center xl:p-16 p-4"
        >
          <div id="project-loading" role="status" aria-live="polite" aria-hidden="true">
            <svg viewBox="0 0 28 16" aria-hidden="true">
              <path d={logoPath} class="loading-base" />
              <path d={logoPath} pathLength="360" class="dash-normal" />
              <path d={logoPath} pathLength="360" class="dash-reverse" />
            </svg>
          </div>
          <!-- Wrapper que controla el fade de imagen/logo -->
          <div
            id="project-visual"
            data-media-entry="pending"
            class="max-h-[70%] w-full min-h-0 flex items-center justify-center transition-opacity duration-300 ease-in-out"
          >
            <div
              id="project-media-stage"
              class="relative inline-flex flex-col items-center justify-center max-h-full max-w-full min-h-0"
            >
              <img
                id="project-image"
                src={initialProject.mediaType === "image" ? initialProject.image?.src : undefined}
                alt={initialProject.image?.alt ?? ""}
                class={`min-h-0 max-h-full w-auto max-w-full object-contain rounded-2xl p-0.5 shadow-[0px_2px_5px_#e1e1e1] ${initialProject.mediaType !== "image" ? "hidden" : ""}`}
              />
              <video
                id="project-video"
                data-src={initialProject.mediaType === "video" ? initialProject.video ?? undefined : undefined}
                poster={initialProject.mediaType === "video" ? getVideoPoster(initialProject.image?.src) : undefined}
                aria-label={initialProject.title}
                muted
                loop
                playsinline
                preload="none"
                width="1280"
                height="720"
                class={`min-h-0 aspect-video w-auto h-auto max-h-full max-w-full object-contain rounded-2xl ${initialProject.mediaType !== "video" ? "hidden" : ""}`}
              />

              <!-- LogoCard: oculto por defecto -->
              <div
                id="project-logocard"
                class={`${initialProject.mediaType !== "logo" ? "hidden" : ""} flex items-center justify-center`}
              >
                <LogoCard />
              </div>

              <a
                id="project-media-overlay"
                href={initialProject.url ?? "#"}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={initialProject.url ? `${viewProjectLabel}: ${initialProject.title}` : undefined}
                class={`project-media-overlay project-media-overlay--rounded ${initialProject.mediaType === "video" ? "project-media-overlay--video" : ""} ${!initialProject.url || (initialProject.mediaType === "image" && !initialProject.image?.src) ? "hidden" : ""}`}
              >
                <span class="project-media-cta" aria-hidden="true">
                  <span>{viewProjectLabel}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </span>
              </a>
            </div>
          </div>

          <!-- Descripción con fade -->
          <p
            id="project-description"
            class="text-lg font-light text-gray-600 whitespace-pre-line text-center transition-opacity duration-300 ease-in-out"
          >
            {initialProject.description}
          </p>
          <a
            id="project-details-link"
            href={initialProject.url ?? "#"}
            target="_blank"
            rel="noopener noreferrer"
            class={`text-primary underline ${!initialProject.url ? "hidden" : initialProject.mediaType !== "logo" ? "[@media(hover:hover)_and_(pointer:fine)]:hidden" : ""}`}
          >{viewProjectLabel}</a>
        </div>
      </div>
    </div>
  </div>
</section>}

<noscript><style is:inline>
  #project-visual[data-media-entry] { opacity: 1; transform: none; pointer-events: auto; }
</style></noscript>

<style>
  #project-visual[data-media-entry] {
    transition: opacity 240ms cubic-bezier(0.23, 1, 0.32, 1), transform 240ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  #project-visual[data-media-entry="pending"] {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  #project-visual[data-media-entry="ready"] { opacity: 1; transform: translateY(0); }
  #project-media-overlay {
    top: var(--overlay-top, 0px);
    left: var(--overlay-left, 0px);
    width: var(--overlay-width, 100%);
    height: var(--overlay-height, 100%);
    right: auto;
    bottom: auto;
  }

  #project-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
  }

  #project-loading.is-loading {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  #project-loading svg {
    width: 72px;
    height: auto;
    overflow: visible;
    opacity: 0.45;
  }

  #project-loading path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-linecap: round;
    animation-play-state: paused;
  }

  #project-loading.is-loading path {
    animation-play-state: running;
  }

  #project-loading .loading-base { opacity: 0.15; }


  @media (prefers-reduced-motion: reduce) {
    #project-media-overlay.project-media-overlay--video {
      height: max(0px, calc(var(--overlay-height, 100%) - 2.75rem));
    }
    #project-loading { transition: none; }
    #project-loading path { animation: none; }
    #project-visual, #project-description, #project-visual[data-media-entry] { transition: none; transform: none; }
  }
</style>

<script
  id="projects-data"
  type="application/json"
  set:html={JSON.stringify(projectsData).replace(/</g, "\\u003c")}
/>

<script>
  import {waitForProjectMedia, createProjectMediaEntrance} from "../../scripts/project-media-entry";
  import { createProjectVideos } from "../../scripts/project-videos";
  import { createProjectMediaFollow } from "../../scripts/project-media-follow";
  let cleanupProjects = () => {};

  function initializeProjects() {
    cleanupProjects();
    if (!document.getElementById("projects-data") || !document.getElementById("projects")) return;
    const controller = new AbortController();
    let fadeTimeout;
    let fadeFrame;
    let selectionVersion = 0;
    let loadingTimeout;
    let selectionController = new AbortController();
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const projects = JSON.parse(
    document.getElementById("projects-data").textContent,
  );

  const visualEl = document.getElementById("project-visual");
  const stageEl = document.getElementById("project-media-stage");
  let imgEl = document.getElementById("project-image") as HTMLImageElement;
  const mediaOverlayEl = document.getElementById("project-media-overlay") as HTMLAnchorElement;
  const logoEl = document.getElementById("project-logocard");
  let videoEl = document.getElementById("project-video") as HTMLVideoElement;
  const videos = createProjectVideos();
  videos.observe(videoEl);
  const mediaFollow = createProjectMediaFollow({ root: visualEl });
  const detailsLinkEl = document.getElementById("project-details-link") as HTMLAnchorElement;
  const viewProjectText = detailsLinkEl.textContent?.trim() || "Ver proyecto";
  const descriptionEl = document.getElementById("project-description");
  const loadingEl = document.getElementById("project-loading");

  const syncOverlayBounds = () => {
    if (!stageEl || !mediaOverlayEl) return;
    const activeMedia =
      !imgEl.classList.contains("hidden")
        ? imgEl
        : !videoEl.classList.contains("hidden")
          ? videoEl
          : !logoEl.classList.contains("hidden")
            ? logoEl
            : null;
    if (!activeMedia || mediaOverlayEl.classList.contains("hidden")) {
      mediaOverlayEl.style.removeProperty("--overlay-left");
      mediaOverlayEl.style.removeProperty("--overlay-top");
      mediaOverlayEl.style.removeProperty("--overlay-width");
      mediaOverlayEl.style.removeProperty("--overlay-height");
      return;
    }
    const stageRect = stageEl.getBoundingClientRect();
    const mediaRect = activeMedia.getBoundingClientRect();
    if (mediaRect.width <= 0 || mediaRect.height <= 0) return;
    mediaOverlayEl.style.setProperty("--overlay-left", `${(mediaRect.left - stageRect.left).toFixed(2)}px`);
    mediaOverlayEl.style.setProperty("--overlay-top", `${(mediaRect.top - stageRect.top).toFixed(2)}px`);
    mediaOverlayEl.style.setProperty("--overlay-width", `${mediaRect.width.toFixed(2)}px`);
    mediaOverlayEl.style.setProperty("--overlay-height", `${mediaRect.height.toFixed(2)}px`);
  };

  const overlayResizeObserver = new ResizeObserver(syncOverlayBounds);
  [visualEl, stageEl, imgEl, videoEl, logoEl].forEach((el) => {
    if (el) overlayResizeObserver.observe(el);
  });
  syncOverlayBounds();

  const hideLoading = () => {
    clearTimeout(loadingTimeout);
    loadingEl.classList.remove("is-loading");
    loadingEl.setAttribute("aria-hidden", "true");
  };

  const trackLoading = (ready: Promise<boolean>, version: number) => {
    hideLoading();
    loadingTimeout = setTimeout(() => {
      if (!controller.signal.aborted && version === selectionVersion) {
        loadingEl.classList.add("is-loading");
        loadingEl.setAttribute("aria-hidden", "false");
      }
    }, 180);
    void ready.then(() => {
      if (!controller.signal.aborted && version === selectionVersion) {
        clearTimeout(loadingTimeout);
      }
    });
  };

  const initialEntrance = createProjectMediaEntrance({
    element: visualEl,
    getMedia: () => projects[0]?.mediaType === "video" ? videoEl : projects[0]?.hasComponent ? logoEl : imgEl,
    signal: controller.signal,
    reducedMotion: reducedMotion.matches,
    onPending: (ready) => trackLoading(ready, 0),
    onReady: () => { hideLoading(); syncOverlayBounds(); },
  });

  // Duración del fade en ms — debe coincidir con duration-300 de Tailwind (300ms)
  const FADE_DURATION = 300;

  const updateUnderlineWidths = () => {
    document.querySelectorAll("#project-titles h2").forEach((title) => {
      const range = document.createRange();
      range.selectNodeContents(title);
      const widths = Array.from(range.getClientRects()).map((rect) => rect.width);

      title.style.setProperty(
        "--underline-width",
        `${Math.max(...widths, 0)}px`,
      );
    });
  };

  updateUnderlineWidths();
  window.addEventListener("resize", updateUnderlineWidths, { signal: controller.signal });
  document.fonts.ready.then(() => {
    if (!controller.signal.aborted) {
      updateUnderlineWidths();
      syncOverlayBounds();
    }
  });

  window.selectProject = function (el) {
    const index = Number(el.dataset.index);
    const project = projects[index];

    // Si ya está seleccionado, no hacer nada
    if (el.classList.contains("font-semibold")) return;
    const version = ++selectionVersion;
    initialEntrance.cancel();
    selectionController.abort();
    selectionController = new AbortController();
    const selectionSignal = selectionController.signal;
    videos.unobserve(videoEl);

    // Cargar una imagen independiente para no conservar los píxeles anteriores.
    const nextImage = project.mediaType === "image" && project.image?.src ? imgEl.cloneNode(false) as HTMLImageElement : null;
    const imageReady = nextImage
      ? (() => {
          nextImage.src = project.image?.src ?? "";
          nextImage.alt = project.image?.alt ?? "";
          return nextImage.decode().then(() => true, () => false);
        })()
      : Promise.resolve(true);
    trackLoading(imageReady, version);

    // 1) Títulos: activo en negro, resto en gris
    document.querySelectorAll("#project-titles h2").forEach((h, i) => {
      h.className =
        i === index
          ? "relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)] font-semibold text-primary"
          : "relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)] font-light text-gray-400 hover:text-gray-600";
    });

    // 2) Fade out visual + descripción
    visualEl.classList.add("opacity-0");
    descriptionEl.classList.add("opacity-0");

    // 3) Tras el fade out, swap de contenido y fade in
    clearTimeout(fadeTimeout);
    cancelAnimationFrame(fadeFrame);
    fadeTimeout = setTimeout(async () => {
      const loaded = await imageReady;
      if (controller.signal.aborted || version !== selectionVersion) return;

      // Ocultar todo primero
      imgEl.classList.add("hidden");
      logoEl.classList.add("hidden");
      videoEl.classList.add("hidden");
      videoEl.pause();
      videoEl.removeAttribute("src");
      delete videoEl.dataset.src;
      videoEl.preload = "none";
      videoEl.load();

      let hasVisibleMedia = false;

      if (project.hasComponent) {
        logoEl.classList.remove("hidden");
        hasVisibleMedia = true;
      } else if (project.mediaType === "video") {
        const nextVideo = videoEl.cloneNode(false) as HTMLVideoElement;
        nextVideo.style.removeProperty("aspect-ratio");
        nextVideo.muted = true;
        if (project.video) {
          nextVideo.dataset.src = project.video;
          if (project.poster) nextVideo.poster = project.poster;
          else nextVideo.removeAttribute("poster");
          nextVideo.setAttribute("aria-label", project.title);
          nextVideo.classList.remove("hidden");
          hasVisibleMedia = true;
        }
        overlayResizeObserver.unobserve(videoEl);
        videoEl.replaceWith(nextVideo);
        videoEl = nextVideo;
        overlayResizeObserver.observe(videoEl);
        videos.observe(videoEl);
      } else if (loaded && nextImage) {
        nextImage.classList.remove("hidden");
        overlayResizeObserver.unobserve(imgEl);
        imgEl.replaceWith(nextImage);
        imgEl = nextImage;
        overlayResizeObserver.observe(imgEl);
        hasVisibleMedia = true;
      }

      if (project.url && hasVisibleMedia) {
        mediaOverlayEl.href = project.url;
        mediaOverlayEl.setAttribute("aria-label", `${viewProjectText}: ${project.title}`);
        mediaOverlayEl.classList.toggle("project-media-overlay--video", project.mediaType === "video");
        mediaOverlayEl.classList.remove("hidden");
      } else {
        mediaOverlayEl.href = "#";
        mediaOverlayEl.removeAttribute("aria-label");
        mediaOverlayEl.classList.remove("project-media-overlay--video");
        mediaOverlayEl.classList.add("hidden");
      }
      mediaFollow.reset();
      syncOverlayBounds();

      detailsLinkEl.classList.toggle("hidden", !project.url);
      detailsLinkEl.classList.toggle("[@media(hover:hover)_and_(pointer:fine)]:hidden", Boolean(project.url) && !project.hasComponent);
      detailsLinkEl.href = project.url || "#";

      // Swap descripción
      descriptionEl.textContent = project.description;

      if (project.mediaType === "video" && hasVisibleMedia) {
        const ready = waitForProjectMedia(videoEl, {signal: selectionSignal, reducedMotion: reducedMotion.matches});
        trackLoading(ready, version);
        await ready;
        if (controller.signal.aborted || version !== selectionVersion) return;
      }

      // Fade in (se necesita un frame para que el navegador registre el cambio)
      fadeFrame = requestAnimationFrame(() => {
        if (controller.signal.aborted || version !== selectionVersion) return;
        syncOverlayBounds();
        hideLoading();
        visualEl.classList.remove("opacity-0");
        descriptionEl.classList.remove("opacity-0");
      });
    }, FADE_DURATION);
  };
    cleanupProjects = () => {
      controller.abort();
      selectionController.abort();
      overlayResizeObserver.disconnect();
      mediaFollow.disconnect();
      videos.disconnect();
      hideLoading();
      clearTimeout(fadeTimeout);
      cancelAnimationFrame(fadeFrame);
      delete window.selectProject;
      cleanupProjects = () => {};
    };
  }

  document.addEventListener("astro:page-load", initializeProjects);
  document.addEventListener("astro:before-swap", () => cleanupProjects());
</script>
