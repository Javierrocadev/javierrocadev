---
import LogoCard from "./LogoCard.astro";
import { getProjects } from "../../lib/projects";
import logoSvg from "/public/favicon.svg?raw";
const logoPath = logoSvg.match(/\bd="([^"]+)"/)?.[1];
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const projects = await getProjects(lang);
const initialProject = projects[0];

const projectsData = projects.map((p, i) => ({
  index: i,
  title: p.title,
  hasComponent: p.mediaType === "logo",
  mediaType: p.mediaType,
  image: p.image || null,
  video: p.video,
  description: p.description,
  url: p.url || null,
}));
---

{initialProject && <section id="projects" class="bg-white text-gray-900 py-20 px-6 lg:px-10">
  <div class="mx-auto">
    <div
      class="flex flex-col gap-16 lg:flex-row items-start mb-10 md:mb-16 space-y-4 sm:space-y-0"
    >
      <!-- LEFT: Títulos -->
      <div class="max-w-xl" id="project-titles">
        {
          projects.map((project, index) => (
            <h2
              class={`relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)]
              ${index === 0 ? "font-semibold text-primary" : "font-light text-gray-400 hover:text-gray-600"}`}
              data-index={index}
              onclick="selectProject(this)"
            >
              {project.title}
            </h2>
          ))
        }
        <a
          href={lang === "es" ? "/projects" : "/en/projects"}
          class="inline-flex items-center gap-3 mt-6 rounded-full border border-primary px-5 py-3 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
        >
          {lang === "es" ? "Ver todos los proyectos" : "View all projects"}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- RIGHT -->
      <div
        class="w-full sm:aspect-video aspect-auto rounded-2xl bg-primary/20 overflow-hidden flex items-center justify-center"
      >
        <div
          class="min-h-96 relative w-full h-full flex flex-col gap-4 justify-center items-center xl:p-16 p-4"
        >
          <div id="project-loading" role="status" aria-live="polite" aria-hidden="true">
            <svg viewBox="0 0 28 16" aria-hidden="true">
              <path d={logoPath} class="loading-base" />
              <path d={logoPath} pathLength="360" class="dash-normal" />
              <path d={logoPath} pathLength="360" class="dash-reverse" />
            </svg>
          </div>
          <!-- Wrapper que controla el fade de imagen/logo -->
          <div
            id="project-visual"
            class="max-h-[70%] w-full flex items-center justify-center transition-opacity duration-300 ease-in-out"
          >
            <!-- Siempre un <a> fijo; se activa/desactiva según haya URL -->
            <a
              id="project-link"
              href={initialProject.url ?? "#"}
              target="_blank"
              rel="noopener noreferrer"
              class={`contents ${!initialProject.url ? "pointer-events-none" : ""} ${initialProject.mediaType !== "image" ? "hidden" : ""}`}
            >
              <img
                id="project-image"
                src={initialProject.mediaType === "image" ? initialProject.image?.src : undefined}
                alt={initialProject.image?.alt ?? ""}
                class="max-h-full object-cover rounded-2xl p-0.5 shadow-[0px_2px_5px_#e1e1e1] hover:shadow-md hover:scale-95 hover:rotate-2 transition-all duration-300"
              />
            </a>
            <video
              id="project-video"
              src={initialProject.mediaType === "video" ? initialProject.video ?? undefined : undefined}
              poster={initialProject.mediaType === "video" ? initialProject.image?.src : undefined}
              aria-label={initialProject.title}
              controls
              playsinline
              preload="metadata"
              class={`max-h-full max-w-full rounded-2xl ${initialProject.mediaType !== "video" ? "hidden" : ""}`}
            />

            <!-- LogoCard: oculto por defecto -->
            <div
              id="project-logocard"
              class={`${initialProject.mediaType !== "logo" ? "hidden" : ""} flex items-center justify-center`}
            >
              <LogoCard />
            </div>
          </div>

          <!-- Descripción con fade -->
          <p
            id="project-description"
            class="text-lg font-light text-gray-600 whitespace-pre-line text-center transition-opacity duration-300 ease-in-out"
          >
            {initialProject.description}
          </p>
          <a
            id="project-details-link"
            href={initialProject.url ?? "#"}
            target="_blank"
            rel="noopener noreferrer"
            class={`text-primary underline ${initialProject.mediaType === "image" || !initialProject.url ? "hidden" : ""}`}
          >{lang === "es" ? "Ver proyecto" : "View project"}</a>
        </div>
      </div>
    </div>
  </div>
</section>}

<style>
  #project-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
  }

  #project-loading.is-loading {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  #project-loading svg {
    width: 72px;
    height: auto;
    overflow: visible;
    opacity: 0.45;
  }

  #project-loading path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-linecap: round;
    animation-play-state: paused;
  }

  #project-loading.is-loading path {
    animation-play-state: running;
  }

  #project-loading .loading-base { opacity: 0.15; }


  @media (prefers-reduced-motion: reduce) {
    #project-loading { transition: none; }
    #project-loading path { animation: none; }
    #project-visual, #project-description { transition: none; }
  }
</style>

<script
  id="projects-data"
  type="application/json"
  set:html={JSON.stringify(projectsData).replace(/</g, "\\u003c")}
/>

<script>
  let cleanupProjects = () => {};

  function initializeProjects() {
    cleanupProjects();
    if (!document.getElementById("projects-data") || !document.getElementById("projects")) return;
    const controller = new AbortController();
    let fadeTimeout;
    let fadeFrame;
    let selectionVersion = 0;
    let loadingTimeout;

  const projects = JSON.parse(
    document.getElementById("projects-data").textContent,
  );

  const visualEl = document.getElementById("project-visual");
  let imgEl = document.getElementById("project-image") as HTMLImageElement;
  const linkEl = document.getElementById("project-link");
  const logoEl = document.getElementById("project-logocard");
  let videoEl = document.getElementById("project-video") as HTMLVideoElement;
  const detailsLinkEl = document.getElementById("project-details-link") as HTMLAnchorElement;
  const descriptionEl = document.getElementById("project-description");
  const loadingEl = document.getElementById("project-loading");

  const hideLoading = () => {
    clearTimeout(loadingTimeout);
    loadingEl.classList.remove("is-loading");
    loadingEl.setAttribute("aria-hidden", "true");
  };

  const trackLoading = (ready: Promise<boolean>, version: number) => {
    hideLoading();
    loadingTimeout = setTimeout(() => {
      if (!controller.signal.aborted && version === selectionVersion) {
        loadingEl.classList.add("is-loading");
        loadingEl.setAttribute("aria-hidden", "false");
      }
    }, 180);
    void ready.then(() => {
      if (!controller.signal.aborted && version === selectionVersion) {
        clearTimeout(loadingTimeout);
      }
    });
  };

  if (projects[0]?.mediaType === "image" && !imgEl.complete) {
    const initialReady = imgEl.decode().then(() => true, () => false);
    trackLoading(initialReady, 0);
    void initialReady.then(() => {
      if (!controller.signal.aborted && selectionVersion === 0) hideLoading();
    });
  }

  // Duración del fade en ms — debe coincidir con duration-300 de Tailwind (300ms)
  const FADE_DURATION = 300;

  const updateUnderlineWidths = () => {
    document.querySelectorAll("#project-titles h2").forEach((title) => {
      const range = document.createRange();
      range.selectNodeContents(title);
      const widths = Array.from(range.getClientRects()).map((rect) => rect.width);

      title.style.setProperty(
        "--underline-width",
        `${Math.max(...widths, 0)}px`,
      );
    });
  };

  updateUnderlineWidths();
  window.addEventListener("resize", updateUnderlineWidths, { signal: controller.signal });
  document.fonts.ready.then(() => {
    if (!controller.signal.aborted) updateUnderlineWidths();
  });

  window.selectProject = function (el) {
    const index = Number(el.dataset.index);
    const project = projects[index];

    // Si ya está seleccionado, no hacer nada
    if (el.classList.contains("font-semibold")) return;
    const version = ++selectionVersion;
    videoEl.pause();

    // Cargar una imagen independiente para no conservar los píxeles anteriores.
    const nextImage = project.mediaType === "image" && project.image?.src ? imgEl.cloneNode(false) as HTMLImageElement : null;
    const imageReady = nextImage
      ? (() => {
          nextImage.src = project.image?.src ?? "";
          nextImage.alt = project.image?.alt ?? "";
          return nextImage.decode().then(() => true, () => false);
        })()
      : Promise.resolve(true);
    trackLoading(imageReady, version);

    // 1) Títulos: activo en negro, resto en gris
    document.querySelectorAll("#project-titles h2").forEach((h, i) => {
      h.className =
        i === index
          ? "relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)] font-semibold text-primary"
          : "relative w-fit text-3xl mb-4 cursor-pointer transition-colors duration-300 select-none after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-primary after:transition-[width] after:duration-300 hover:after:w-[var(--underline-width)] font-light text-gray-400 hover:text-gray-600";
    });

    // 2) Fade out visual + descripción
    visualEl.classList.add("opacity-0");
    descriptionEl.classList.add("opacity-0");

    // 3) Tras el fade out, swap de contenido y fade in
    clearTimeout(fadeTimeout);
    cancelAnimationFrame(fadeFrame);
    fadeTimeout = setTimeout(async () => {
      const loaded = await imageReady;
      if (controller.signal.aborted || version !== selectionVersion) return;

      // Ocultar todo primero
      imgEl.classList.add("hidden");
      logoEl.classList.add("hidden");
      videoEl.classList.add("hidden");
      videoEl.pause();
      videoEl.removeAttribute("src");
      videoEl.load();
      detailsLinkEl.classList.toggle("hidden", project.mediaType === "image" || !project.url);
      detailsLinkEl.href = project.url || "#";

      if (project.hasComponent) {
        // Ocultar link y mostrar LogoCard
        linkEl.classList.add("hidden");
        logoEl.classList.remove("hidden");
      } else if (project.mediaType === "video") {
        linkEl.classList.add("hidden");
        const nextVideo = videoEl.cloneNode(false) as HTMLVideoElement;
        if (project.video) {
          nextVideo.src = project.video;
          nextVideo.poster = project.image?.src ?? "";
          nextVideo.setAttribute("aria-label", project.title);
          nextVideo.classList.remove("hidden");
        }
        videoEl.replaceWith(nextVideo);
        videoEl = nextVideo;
        videoEl.load();
      } else {
        // Mostrar imagen
        linkEl.classList.remove("hidden");
        if (loaded && nextImage) {
          nextImage.classList.remove("hidden");
          imgEl.replaceWith(nextImage);
          imgEl = nextImage;
        } else {
          // No mostrar la imagen anterior si la nueva no se puede cargar.
          linkEl.classList.add("hidden");
        }

        // Activar o desactivar el enlace según haya URL
        if (project.url) {
          linkEl.href = project.url;
          linkEl.classList.remove("pointer-events-none");
        } else {
          linkEl.href = "#";
          linkEl.classList.add("pointer-events-none");
        }
      }

      // Swap descripción
      descriptionEl.textContent = project.description;

      // Fade in (se necesita un frame para que el navegador registre el cambio)
      fadeFrame = requestAnimationFrame(() => {
        if (controller.signal.aborted || version !== selectionVersion) return;
        hideLoading();
        visualEl.classList.remove("opacity-0");
        descriptionEl.classList.remove("opacity-0");
      });
    }, FADE_DURATION);
  };
    cleanupProjects = () => {
      controller.abort();
      videoEl.pause();
      hideLoading();
      clearTimeout(fadeTimeout);
      cancelAnimationFrame(fadeFrame);
      delete window.selectProject;
      cleanupProjects = () => {};
    };
  }

  document.addEventListener("astro:page-load", initializeProjects);
  document.addEventListener("astro:before-swap", () => cleanupProjects());
</script>
